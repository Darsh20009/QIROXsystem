modules = ["nodejs-20", "web", "lua-5.2", "python-base-3.13", "go-1.25"]

[agent]
expertMode = true
stack = "FULLSTACK_JS"

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "QMeet Native SFU"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[[workflows.workflow]]
name = "QMeet Native SFU"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd services/qmeet-sfu && go run -tags pion ./cmd/qmeet-sfu"
waitForPort = 8008

[workflows.workflow.metadata]
outputType = "console"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3002

[[ports]]
localPort = 6100
externalPort = 4200

[[ports]]
localPort = 8008
externalPort = 8008

[[ports]]
localPort = 10000
externalPort = 3001

[[ports]]
localPort = 23636
externalPort = 3000

[deployment]
deploymentTarget = "autoscale"
build = ["npm", "run", "build"]
publicDir = "dist"
run = ["node", "./dist/index.cjs"]

[userenv]

[userenv.shared]
PORT = "5000"
FEATURE_NATIVE_SFU = "true"
QMEET_SFU_ADDR = ":8008"
QMEET_SFU_ALLOWED_ORIGINS = "https://d5c542de-437a-45b2-a75b-c35c6efc753c-00-1z93j4za1zdht.sisko.replit.dev"
QMEET_SFU_URL = "wss://d5c542de-437a-45b2-a75b-c35c6efc753c-00-1z93j4za1zdht.sisko.replit.dev:8008/ws"
MAIL_ALERT_CEO_WHATSAPP_NUMBER = "+966532441566"

[userenv.development]
FEATURE_EMPLOYEE_OPERATIONS_V2 = "true"
